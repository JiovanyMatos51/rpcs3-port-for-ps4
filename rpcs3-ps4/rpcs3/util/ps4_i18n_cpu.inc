// CPU-side strings: memory governor (MEMGOV_*), toasts of the PPU/SPU recompilers, the boot and cellGame (TOAST_*).
// I18N(id, pt-BR, en, es, ar); "" = not translated yet (falls back to English, then pt-BR). Rules in ps4_i18n.hpp.
// UTF-8 without BOM, LF line ends.

// MEMGOV_ - util/ps4_memory_governor.hpp
I18N(MEMGOV_MEMORIA_EMULADOR_QUASE_ESGOTADA_SALVE, "Memória do emulador quase esgotada: salve o jogo agora e reinicie o aplicativo depois", "Emulator memory almost exhausted: save your game now and restart the application afterwards", "Memoria del emulador casi agotada: guarda la partida ahora y reinicia la aplicación después", "ذاكرة المحاكي على وشك النفاد: احفظ اللعبة الآن ثم أعد تشغيل التطبيق")
I18N(MEMGOV_RPCS3_MEMORIA_EMULADOR_BAIXA_SALVE, "RPCS3: memória do emulador baixa. Salve o jogo; as compilações ficam mais lentas até a memória voltar.", "RPCS3: emulator memory is low. Save your game; compiling stays slower until memory recovers.", "RPCS3: memoria del emulador baja. Guarda la partida; las compilaciones irán más lentas hasta que se recupere la memoria.", "RPCS3: ذاكرة المحاكي منخفضة. احفظ اللعبة؛ ستبقى عمليات التجميع أبطأ حتى تتوفر الذاكرة من جديد.")

// TOAST_ - Emu/Cell/PPUThread.cpp, Emu/Cell/SPUCommonRecompiler.cpp, Emu/System.cpp, Emu/Cell/Modules/cellGame.cpp
I18N(TOAST_RPCS3_MEMORIA_JIT_ESGOTADA_CARREGAR, "RPCS3: memória JIT esgotada ao carregar código do jogo. O jogo será fechado e você volta ao menu.", "RPCS3: JIT memory exhausted while loading the game's code. The game will close and you return to the menu.", "RPCS3: memoria JIT agotada al cargar el código del juego. El juego se cerrará y volverás al menú.", "RPCS3: نفدت ذاكرة JIT أثناء تحميل شيفرة اللعبة. سيتم إغلاق اللعبة والعودة إلى القائمة.")
I18N(TOAST_RPCS3_MEMORIA_JIT_ESGOTADA_PARTE, "RPCS3: memória JIT esgotada. Parte do código do jogo roda no interpretador (mais lento). Salve o jogo.", "RPCS3: JIT memory exhausted. Part of the game's code runs on the interpreter (slower). Save your game.", "RPCS3: memoria JIT agotada. Parte del código del juego se ejecuta en el intérprete (más lento). Guarda la partida.", "RPCS3: نفدت ذاكرة JIT. جزء من شيفرة اللعبة يعمل على المفسر (أبطأ). احفظ اللعبة.")
I18N(TOAST_RPCS3_CACHE_JOGO_SEM_PERMISSAO, "RPCS3: cache do jogo sem permissão: ligue o FTP do GoldHEN e abra o RPCS3 de novo", "RPCS3: no permission for the game cache: turn on the GoldHEN FTP and open RPCS3 again", "RPCS3: caché del juego sin permiso: activa el FTP de GoldHEN y abre RPCS3 de nuevo", "RPCS3: لا يوجد إذن لذاكرة اللعبة المؤقتة: قم بتشغيل FTP في GoldHEN ثم افتح RPCS3 من جديد")
I18N(TOAST_RPCS3_SEM_ESPACO_CACHE_PPU, "RPCS3: sem espaco para o cache PPU (HDD cheio?). O jogo segue sem cache e fica lento; libere espaco.", "RPCS3: no space for the PPU cache (HDD full?). The game goes on without a cache and runs slowly; free up space.", "RPCS3: sin espacio para la caché PPU (¿HDD lleno?). El juego sigue sin caché y va lento; libera espacio.", "RPCS3: لا توجد مساحة لذاكرة PPU المؤقتة (هل HDD ممتلئ؟). تستمر اللعبة دون ذاكرة مؤقتة وتصبح بطيئة؛ حرر بعض المساحة.")
I18N(TOAST_RPCS3_MEMORIA_INSUFICIENTE_COMPILAR_ABRA, "RPCS3: memoria insuficiente ao compilar. Abra o jogo de novo: o que ja foi compilado ficou salvo e a proxima vez usa menos memoria.", "RPCS3: not enough memory while compiling. Open the game again: what was already compiled is saved and the next run uses less memory.", "RPCS3: memoria insuficiente al compilar. Abre el juego de nuevo: lo ya compilado quedó guardado y la próxima vez usará menos memoria.", "RPCS3: الذاكرة غير كافية أثناء التجميع. افتح اللعبة من جديد: ما تم تجميعه محفوظ والمرة القادمة تستخدم ذاكرة أقل.")
I18N(TOAST_RPCS3_NAO_FOI_POSSIVEL_SALVAR, "RPCS3: nao foi possivel salvar o cache PPU (HDD cheio?). Libere espaco e abra o jogo de novo.", "RPCS3: the PPU cache could not be saved (HDD full?). Free up space and open the game again.", "RPCS3: no se pudo guardar la caché PPU (¿HDD lleno?). Libera espacio y abre el juego de nuevo.", "RPCS3: تعذر حفظ ذاكرة PPU المؤقتة (هل HDD ممتلئ؟). حرر بعض المساحة وافتح اللعبة من جديد.")
I18N(TOAST_RPCS3_ARQUIVO_CACHE_PPU_ESTAVA, "RPCS3: um arquivo do cache PPU estava danificado. Abra o jogo de novo para recompilar.", "RPCS3: a PPU cache file was damaged. Open the game again to recompile.", "RPCS3: un archivo de la caché PPU estaba dañado. Abre el juego de nuevo para recompilar.", "RPCS3: كان أحد ملفات ذاكرة PPU المؤقتة تالفا. افتح اللعبة من جديد لإعادة التجميع.")
I18N(TOAST_RPCS3_MEMORIA_JIT_ESGOTADA_PARTE_2, "RPCS3: memória JIT esgotada, parte do código SPU roda em modo interpretado (lento). Salve o jogo e reinicie o aplicativo.", "RPCS3: JIT memory exhausted, part of the SPU code runs in interpreted mode (slow). Save your game and restart the application.", "RPCS3: memoria JIT agotada, parte del código SPU se ejecuta en modo interpretado (lento). Guarda la partida y reinicia la aplicación.", "RPCS3: نفدت ذاكرة JIT، وجزء من شيفرة SPU يعمل في وضع التفسير (بطيء). احفظ اللعبة وأعد تشغيل التطبيق.")
I18N(TOAST_RPCS3_CONFIGURACAO_AUTOMATICA_ATIVA_AJUSTE, "RPCS3: configuracao automatica ativa para {0} ({1} ajuste(s))", "RPCS3: automatic configuration active for {0} ({1} change(s))", "RPCS3: configuración automática activa para {0} ({1} ajuste(s))", "RPCS3: الإعداد التلقائي مفعل للعبة {0} (التعديلات: {1})")
I18N(TOAST_RPCS3_JOGO_NAO_PODE_CRIAR_DADOS, "RPCS3: o jogo não pôde criar seus dados em dev_hdd0/game (pasta sem permissão): ligue o FTP do GoldHEN e reabra o RPCS3", "RPCS3: the game could not create its data in dev_hdd0/game (folder without permission): turn on the GoldHEN FTP and reopen RPCS3", "RPCS3: el juego no pudo crear sus datos en dev_hdd0/game (carpeta sin permiso): activa el FTP de GoldHEN y vuelve a abrir RPCS3", "RPCS3: تعذر على اللعبة إنشاء بياناتها في dev_hdd0/game (مجلد بلا إذن): قم بتشغيل FTP في GoldHEN ثم أعد فتح RPCS3")
