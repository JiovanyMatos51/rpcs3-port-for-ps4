# LLVM runs in-process in the emulator and uses the exact same console ABI.
include("${CMAKE_CURRENT_LIST_DIR}/toolchain.cmake")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_ASM_COMPILER_TARGET x86_64-pc-freebsd12-elf)
set(CMAKE_ASM_FLAGS_INIT "${_RPCS3_PS4_COMMON_FLAGS}")
get_filename_component(_llvm_port_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_llvm_orbis_compat "${_llvm_port_root}/../orbis-compat/include")
set(_llvm_sdk_options "-I\"${CMAKE_CURRENT_LIST_DIR}/compat\" -I\"${_llvm_orbis_compat}\" -mcx16 -UPS4")
string(APPEND CMAKE_C_FLAGS_INIT " ${_llvm_sdk_options}")
string(APPEND CMAKE_CXX_FLAGS_INIT " ${_llvm_sdk_options}")
# Feature checks compile SDK code; dependencies are provided by the final
# emulator link, and cannot be executed on this Windows build host.
set(LLVM_TABLEGEN "${CMAKE_CURRENT_LIST_DIR}/.build-llvm-host/bin/llvm-tblgen.exe" CACHE FILEPATH "Native table generator")
set(LLVM_TARGETS_TO_BUILD X86 CACHE STRING "Native JIT architecture")
set(LLVM_HOST_TRIPLE x86_64-pc-freebsd12 CACHE STRING "Console JIT triple")
set(LLVM_DEFAULT_TARGET_TRIPLE x86_64-pc-freebsd12 CACHE STRING "Console target triple")
set(LLVM_ENABLE_THREADS ON CACHE BOOL "Compiler worker threads")
set(LLVM_ENABLE_PIC ON CACHE BOOL "Console PIE libraries")
set(LLVM_ENABLE_EH OFF CACHE BOOL "LLVM exceptions")
set(LLVM_ENABLE_RTTI OFF CACHE BOOL "LLVM RTTI")
set(LLVM_ENABLE_ZLIB OFF CACHE BOOL "External zlib")
set(LLVM_ENABLE_ZSTD OFF CACHE BOOL "External zstd")
set(LLVM_ENABLE_LIBXML2 OFF CACHE BOOL "External XML")
set(LLVM_ENABLE_LIBEDIT OFF CACHE BOOL "External terminal editor")
set(LLVM_ENABLE_LIBPFM OFF CACHE BOOL "External profiler")
set(LLVM_ENABLE_Z3_SOLVER OFF CACHE BOOL "External solver")
set(LLVM_ENABLE_CURL OFF CACHE BOOL "External network support")
set(LLVM_ENABLE_HTTPLIB OFF CACHE BOOL "External HTTP server")
set(LLVM_INCLUDE_TESTS OFF CACHE BOOL "Host-only tests")
set(LLVM_INCLUDE_BENCHMARKS OFF CACHE BOOL "Host-only benchmarks")
set(LLVM_INCLUDE_EXAMPLES OFF CACHE BOOL "Host-only examples")
set(LLVM_INCLUDE_DOCS OFF CACHE BOOL "Host documentation")
set(LLVM_BUILD_TOOLS OFF CACHE BOOL "Console command-line tools")
set(LLVM_INCLUDE_UTILS OFF CACHE BOOL "Console utilities")
set(LLVM_ENABLE_WARNINGS OFF CACHE BOOL "Upstream warnings")
set(LLVM_ENABLE_BACKTRACES OFF CACHE BOOL "Use emulator fatal error handler")
set(LLVM_ENABLE_CRASH_OVERRIDES OFF CACHE BOOL "Preserve emulator signal handlers")
